# Copy this file to .env and fill in real values for local dev.
# .env is gitignored on purpose — never commit real credentials.
#
# These seed the one admin account (see db/database.js). They're only
# read the FIRST time the app starts with an empty database — changing
# them later won't update an already-created user unless you delete
# chaoslab.db and let it reseed.

NODE_ENV=development
PORT=3000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Phase 9: leave blank for same-origin-only browser access. If you later host
# the frontend separately, set this to its exact HTTPS origin.
ALLOWED_ORIGIN=

# Optional (Phase 7). Leave all four blank/unset and the app uses local
# disk storage (uploads/) instead — nothing breaks either way. Fill all
# four in to genuinely switch uploaded files to a real AWS S3 bucket.
# See README.md "Setting up AWS S3" for exact setup steps.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
