#!/usr/bin/env bash
# ChaosLab Automated Backup Script
# Copy to /usr/local/bin/backup-chaoslab.sh and make executable (chmod +x)
# Schedule via root crontab (e.g., 0 2 * * * /usr/local/bin/backup-chaoslab.sh)

set -euo pipefail

APP_DIR="/srv/chaoslab"
BACKUP_DIR="/var/backups/chaoslab"
STAMP=$(date +%Y%m%d-%H%M%S)

mkdir -p "$BACKUP_DIR"

# 1. Safe, atomic hot backup of SQLite database using SQLite's backup API
if [ -f "$APP_DIR/chaoslab.db" ]; then
    sqlite3 "$APP_DIR/chaoslab.db" ".backup '$BACKUP_DIR/chaoslab-$STAMP.db'"
    echo "[$(date)] Database backup completed: chaoslab-$STAMP.db"
fi

# 2. Archive local uploads (if using local disk storage)
if [ -d "$APP_DIR/uploads" ]; then
    tar -C "$APP_DIR" -czf "$BACKUP_DIR/uploads-$STAMP.tar.gz" uploads
    echo "[$(date)] Uploads directory archived: uploads-$STAMP.tar.gz"
fi

# 3. Prune backup files older than 14 days
find "$BACKUP_DIR" -type f -mtime +14 -delete
echo "[$(date)] Pruned backup archives older than 14 days."
